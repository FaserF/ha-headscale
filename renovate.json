{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":prHourlyLimitNone",
    ":dependencyDashboard"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Preserve >= minimum pins in HA manifests and test requirements for Hassfest/HA Core compatibility",
      "matchFileNames": [
        "custom_components/**/manifest.json",
        "requirements*.txt"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchCategories": [
        "python"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "github-actions": {
    "enabled": true
  }
}
